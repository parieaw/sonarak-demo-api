# Copy to .env and fill in. The server starts without it, with the defaults in src/config.js.

# Where the API listens
PORT=4100

# Signs session cookies. Any long random string.
SESSION_SECRET=

# The key the payment provider sends with its webhook (x-api-key)
PAYMENT_API_KEY=

# The sender of order emails
MAIL_FROM=orders@example.test

# No longer read anywhere: left here on purpose, for Sonar's "Unused"
LEGACY_REPORT_URL=
